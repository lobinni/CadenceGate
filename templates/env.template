# Copy this file to .env, or export the values in your shell.
# Every address the application uses resolves through these values first.

# Deployed contract address. Highest priority for both the interface and the scripts.
# Release cadencegate-2 ships with this value as its build default.
CADENCEGATE_ADDRESS=0xBCA8c56FD5D2f8dcABA997FDc601b0A4E5CF2E32
CONTRACT_ADDRESS=0xBCA8c56FD5D2f8dcABA997FDc601b0A4E5CF2E32

# Network identity used by the interface and by the read-only verifier.
VITE_CHAIN_ID=61999
VITE_CHAIN_NAME=GenLayer Studio Testnet
VITE_RPC_URL=https://studio.genlayer.com/api
VITE_EXPLORER_URL=https://explorer-studio.genlayer.com

# Optional overrides for the interface only.
VITE_CADENCEGATE_ADDRESS=0xBCA8c56FD5D2f8dcABA997FDc601b0A4E5CF2E32
VITE_CONTRACT_SOURCE=contracts/cadencegate.py
VITE_SOURCE_DOCUMENT_URL=https://raw.githubusercontent.com/github/docs/main/content/graphql/overview/rate-limits-and-query-limits-for-the-graphql-api.md
VITE_SDK_PACKAGE=genlayer-js
